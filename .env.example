# ─────────────────────────────────────────────────────────────
# Easy Single — environment template
# Copy this to .env (local dev) or set these as Vercel env vars.
# ─────────────────────────────────────────────────────────────

# ── AI provider ────────────────────────────────────────────
# "gemini" (default) or "ollama". Ollama can be Ollama Cloud
# (https://ollama.com/v1 with an API key) or a local daemon
# (http://localhost:11434/v1, key can stay empty).
# Users who save their own key in the profile always use Gemini with it.
AI_PROVIDER=gemini
# Fall back to the other provider on quota/key/outage errors, and to the next
# model when one is missing or outside the account's plan.
AI_FALLBACK_ENABLED=true
GEMINI_FALLBACK_MODELS=
OLLAMA_FALLBACK_MODELS=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
# Optional vision model (must accept images). Empty falls back to OLLAMA_MODEL.
OLLAMA_VISION_MODEL=
OLLAMA_REASONING_EFFORT=low
OLLAMA_TOKEN_HEADROOM=160

# ── Google Gemini API ──────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# Optional: override the endpoint (leave as-is unless you use a proxy)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Request pacing. The free tier allows 20 requests per day per model, so the
# app spaces calls out and stops before the quota is gone. Set the budget to
# the limit of your own key (0 disables the guard).
GEMINI_MIN_INTERVAL_SECONDS=4
GEMINI_DAILY_BUDGET=20

# Emotion is inferred locally by default. true spends one extra request per
# chat turn on Gemini-based emotion detection.
GEMINI_LLM_EMOTION=false

# Vision (understanding photos users send). Same key, separate model toggle.
VISION_ENABLED=true
VISION_MODEL=gemini-3.5-flash

# ── Database ───────────────────────────────────────────────
# Leave empty for local SQLite dev (sqlite:///./dev.db).
# For Fly.io Postgres, set to the postgres:// URL from `fly pg attach`.
# For Vercel, set DATABASE_URL to a hosted Postgres (Neon, Vercel Postgres).
DATABASE_URL=

# ── Auth ───────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ───────────────────────────────────────────────────
# Where the frontend runs. Add your Vercel deployment in production:
#   ALLOWED_ORIGINS=https://chat.easyto.me,http://localhost:5173
# Use a single `*` to auto-allow this deployment's own host plus any
# preview subdomain of it (reads VERCEL_URL / FLY_APP_NAME).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Clerk ──────────────────────────────────────────────────
# Publishable key from the Clerk dashboard (frontend only, safe to commit).
# VITE_CLERK_PUBLISHABLE_KEY is read by frontend/src/main.ts at build time.
# VITE_CLERK_PUBLISHABLE_KEY=
# Secret key from the Clerk dashboard (server-side only — never commit).
CLERK_SECRET_KEY=your-clerk-secret-key-here
# API audience — set to your Clerk API endpoint if you use one.
# CLERK_API_AUDIENCE=
# Signing secret from Clerk dashboard (webhooks -> signing secret).
# CLERK_WEBHOOK_SIGNING_SECRET=

# ── App ────────────────────────────────────────────────────
APP_PORT=8000
DEBUG=false

# ── Redis (optional) ───────────────────────────────────────
# Shared captcha / rate-limit storage. Falls back to in-memory when unset.
REDIS_URL=
CAPTCHA_BACKEND=memory

# ── Quotas ─────────────────────────────────────────────────
FREE_DAILY_MESSAGES=50
PREMIUM_DAILY_MESSAGES=500
